# Two ways to reach Jev. You need at least one.

# 1. TypeSafe API, used by --transport direct. Preferred for benchmarking:
#    it reports the model that actually answered, always returns probabilities
#    and confidence, and is not subject to the Gateway free tier's rate limit.
#    Get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# Optional: pin a concrete model instead of following the jev-latest alias.
# List what your account can use with: npx tsx scripts/list-models.mts
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# 2. Vercel AI Gateway, used by --transport gateway (the default).
#    Get one at https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Optional: port for the local UI server (default 3000)
PORT=3000

# Optional: replace the model with code-side density, for demos and UI work
# without spending calls. This changes what the numbers MEAN, not what is being
# measured, so it is a server-side switch rather than a UI control or a URL
# parameter: no link and no stray click can turn it on. The page shows a banner
# whenever it is active, and results are tagged mock-not-a-model.
# JEV_MOCK=1
